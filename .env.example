# PRIESTATE deployment environment — copy to `.env` (gitignored) and fill in.
# Never commit `.env`; it holds wallet secrets. This file is the documented,
# safe-to-commit template.

# --- Wallet identity (choose ONE of the two; unset both to auto-generate) ---

# BIP-39 24-word recovery phrase (Lace-compatible). Derivation uses the
# standard mnemonicToSeed PBKDF2 step — NOT mnemonicToEntropy, which would
# derive a different wallet from the same words.
# MIDNIGHT_WALLET_MNEMONIC=""

# BIP-39 seed as hex (32-128 hex chars; a Lace-compatible seed is 128 chars).
# MIDNIGHT_WALLET_SEED=""

# --- Private state ---

# REQUIRED on public networks (preview/preprod). >= 16 chars. Encrypts the
# local private-state level-db (midnight-level-db/). Locally, on the
# undeployed devnet, a built-in placeholder is used instead.
# PRIVATE_STATE_PASSWORD=""

# --- Network endpoint overrides (optional; defaults target the active network) ---

# MIDNIGHT_INDEXER_URL=""
# MIDNIGHT_INDEXER_WS_URL=""
# MIDNIGHT_NODE_URL=""
# MIDNIGHT_FAUCET_URL=""
# MIDNIGHT_PROOF_SERVER_URL=""

# --- Deploy behavior ---

# Faucet funding wait before failing, in ms (default 600000 = 10 min).
# MIDNIGHT_FAUCET_TIMEOUT_MS=""

# Eligibility threshold passed to the PRIESTATE constructor on deploy
# (default 100000; also settable via --threshold on the deploy script).
# PRIESTATE_THRESHOLD=""

# --- Demo officer authorization (frontend, DEMO ONLY — not real auth) ---

# Comma-separated wallet addresses treated as OFFICER role by the demo
# authorization mechanism. See src/auth/roles.ts and README "Access Control".
# VITE_DEMO_OFFICER_ADDRESSES=""

# --- Demo registration secret keys (DEMO ONLY — see src/secret-keys.ts) ---
#
# The PRIESTATE registration circuits read two 32-byte SECRET keys as private
# witnesses (the wallet connector exposes no raw signing secret, so they are
# configured here for this demo).
#
#   * VITE_PRIESTATE_APPLICANT_SECRET — derives the OWNER binding disclosed on
#     registrations this app submits (submitRegistration).
#   * VITE_PRIESTATE_OFFICER_SECRET   — derives the DApp public key that
#     approve/reject circuits assert equals the sealed officer key.
#     MUST correspond to the officer public key passed to deploy (--officer /
#     PRIESTATE_OFFICER), or on-chain approve/reject is rejected by the circuit.
#
# Each is 64 hex chars (32 bytes). Empty → dummy all-zero secret (authorization
# will fail for the role it feeds).
# VITE_PRIESTATE_APPLICANT_SECRET=""
# VITE_PRIESTATE_OFFICER_SECRET=""

# --- Contact verification / OTP (SERVER-SIDE ONLY — never VITE_*) ---
#
# The real verification flow runs in the PRIESTATE verification API
# (npm run verify-server, see server/index.ts). ALL credentials below are
# read by that Node process only. NEVER put any of these values into a
# VITE_* variable — VITE_ vars are compiled INTO the browser bundle.
#
# The only frontend-visible variable is VITE_VERIFICATION_API_URL below,
# which is a public URL, not a credential.

# ── Verification API server ──
VERIFY_SERVER_PORT=8787
# Comma-separated browser origins allowed to call the API (CORS).
VERIFY_SERVER_ALLOWED_ORIGIN=http://localhost:3000
# HMAC secret used to hash OTPs at rest. Generate with: openssl rand -hex 32
OTP_HASH_SECRET=""

# ── Email delivery (REAL SMTP) — required for email OTP ──
# Any authenticated SMTP account works (e.g. transactional email service).
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="PRIESTATE <no-reply@example.com>"

# ── Email OTP policy (optional; sane defaults shown) ──
EMAIL_OTP_TTL_MINUTES=10
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
EMAIL_OTP_MAX_SENDS_PER_HOUR=5
VERIFY_IP_MAX_SENDS_PER_HOUR=20

# ── Aadhaar-linked mobile verification (authorized KYC provider) ──
# REQUIRED for the "Verify Aadhaar-linked mobile" flow. Use an actual
# authorized identity/KYC provider (UIDAI-licensed ecosystem), e.g.
# Surepass / Karza / Signzy / IDfy / Protean.
#
#   * Without these the UI honestly shows:
#       "Aadhaar-linked mobile verification is currently unavailable."
#   * The adapter performs a direct mobile→Aadhaar link check by default
#     and also supports vendor OTP-challenge flows (challenge/submit paths).
AADHAAR_KYC_PROVIDER="surepass"
AADHAAR_KYC_API_TOKEN=""
# e.g. https://kyc.surepass.io  | https://api.karza.in  | ...
AADHAAR_KYC_BASE_URL=""
# Endpoint path for the mobile↔Aadhaar link check (vendor-specific).
AADHAAR_KYC_MOBILE_LINK_PATH="/api/v1/mobile-to-aadhaar/"
# Optional: OTP-challenge style endpoints (vendor sends an OTP to the
# REGISTERED mobile; user's code is submitted to SUBMIT to finish).
AADHAAR_KYC_CHALLENGE_PATH=""
AADHAAR_KYC_SUBMIT_PATH=""
AADHAAR_KYC_TIMEOUT_MS=20000

# ── Registry metadata API (officer backend support) ──
# Server-side officer credential for the /api/v1/officer/applications routes.
# This is an ADDITIONAL server-side boundary; the authoritative approve/reject
# verdict is still enforced on-chain by the Compact contract. Empty ⇒ the
# registry API reports `unavailable` (fail closed). NEVER used on the browser;
# generate with: openssl rand -hex 32
REGISTRY_OFFICER_API_TOKEN=""

# ── Level 3 user account / mandatory multi-factor (SERVER-SIDE ONLY) ──
#
# PRIESTATE adds secure user accounts bound to a Midnight wallet, with a
# COMPULSORY multi-factor login: wallet + password + Google + SMS OTP +
# WhatsApp OTP + identity/selfie verification (these are NOT alternatives).
#
#   * ACCOUNT_ENC_SECRET — server-only secret deriving the AES-256 key that
#     encrypts account PII (Aadhaar/address/DOB/mobile) at rest. NEVER set a
#     VITE_* var for it. Generate with: openssl rand -hex 32. Missing ⇒ the
#     account feature reports `unavailable` (PII is never stored plainly).
#   * The three gateway variables below gate whether the SMS / WhatsApp /
#     Google factors report `configured` or honestly `unavailable`. Supply
#     REAL gateway/OAuth credentials to enable them; empty ⇒ the UI shows the
#     factor as unavailable (no fake auth, no hard-coded credentials).
ACCOUNT_ENC_SECRET=""
SMS_GATEWAY_PROVIDER=""
WHATSAPP_GATEWAY_API_TOKEN=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""


# --- Frontend (public values only — safe for VITE_*) ---

# Base URL of the verification API as seen from the browser.
# Leave EMPTY in development: the vite dev-server proxies /api →
# VERIFY_SERVER_ORIGIN (default http://localhost:8787).
VITE_VERIFICATION_API_URL=""

# Dev proxy target for local development (vite.config.ts reads this;
# it stays on your machine and is never bundled into client code).
# VERIFY_SERVER_ORIGIN=http://localhost:8787

