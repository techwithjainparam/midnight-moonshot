# Wallet seeds, mnemonics, and environment secrets — never commit these
.env
.env.*
!.env.example
*.seed
*.mnemonic

# SQLite database files (account persistence)
*.db
*.db-journal
*.db-wal
*.db-shm

# Editor / OS
.vscode/
.idea/
.DS_Store

# Vite cache
.vite/
.vercel
.env*
